@startuml 05-diagram-recognition
title Схемы: импорт, очередь и распознавание (DiagramEngine)

start
:файлы из Finder-drop, диалога или пакета\n(группа зафиксирована до загрузки файлов);

partition "ImportQueue — один активный слот (FIFO)" {
  :загрузка URL из NSItemProvider, security scope;
  :probe → SHA-256 оригинала →\nнезависимая копия с повторной проверкой SHA;
  :повторный probe на архивном оригинале —\nметаданные manifest только по нему;
  if (дубль по SHA в снимке архива?) then (да)
    :подтверждённый повтор сохраняет назначение;\nслот удерживается до решения;
  endif
}

partition "DiagramCoordinator «actor»" {
  if (каталог groups.json схем повреждён?) then (да)
    :изменения групп блокируются,\nкаталог не заменяется пустым;
  endif
  :фиксация состава и группы,\nснимок с общей ревизией;
}

:постановка QueueJobID.diagram в общую очередь\n(составные ключи: UUID схем не смешиваются с записями);
note right
  Нет модели схем — задание стоит вне FIFO
  в «Ожидает модель»; роль .diagram не входит
  в audioRoles и невидима для аудио-fingerprint.
  После установки профиля задание входит в FIFO.
end note

:слот очереди → WorkerCommand kind="diagram"\n(аудио-команда идёт без kind);

partition "DiagramEngine — MLXVLM Qwen3-VL" {
  :чтение реальных файлов весов,\nпроверка pinned SHA из каталога;
  :emit «started»;
  if (светлое изображение ≤ 4 Мп, без поворота\nEXIF, есть пустые полосы?) then (да)
    :DiagramImageRegions: деление по пустым\nполосам до 5 областей без пересечений;
    if (области найдены и не диаграмма\nпоследовательности?) then (да)
      :последовательная обработка областей\nодним экземпляром VLM;
      :объединение массивов nodes, edges,\ngeneralizations по порядку;\nпри повторе ID узла выигрывает первое вхождение;
    else (нет)
      :распознавание целого изображения;
    endif
  else (нет)
    :распознавание целого изображения;
  endif
  if (структурный дефект полного ответа?) then (да)
    :одна корректирующая попытка;
  endif
  if (висячие ссылки после коррекции?) then (да)
    :публикация блокируется — «failed»;\nповтор создаст новый run;
    stop
  endif
}

:результат и предупреждения публикуются вместе\nтолько для проверенного запуска\n(DiagramRunInfo: версии pipeline / prompt / preprocessing);
note right
  Повтор создаёт новый run; поздний
  «completed» не публикуется после отмены.
  Ошибка области, превышение лимитов или
  диаграмма последовательности — обработка
  целого изображения.
end note

:экспорт DiagramExport (PlantUML, Mermaid, JSON):\nmanifest, результат, раздел и формат фиксируются\nДО открытия панели сохранения;
stop
@enduml
